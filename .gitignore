# =========================================================
#  BarberApp · .gitignore raíz (monorepo)
#  Solo se sube código fuente, configuración de ejemplo y assets.
# =========================================================

# ---------- Dependencias ----------
node_modules/
.pnpm-store/
.pnp
.pnp.js

# ---------- Builds / cachés ----------
dist/
dev-dist/
build/
.vite/
.cache/
coverage/
*.tsbuildinfo

# ---------- Python / Django ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.eggs/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Base de datos local y estáticos generados
db.sqlite3
*.sqlite3
*.sqlite3-journal
backend/media/
backend/staticfiles/
local_settings.py

# Binarios nativos de GeoDjango/SpatiaLite (instalar en local, ver README)
backend/.spatialite/
backend/.gdal/

# ---------- Entorno / secretos ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
# Notas locales de cuentas de prueba: nunca se suben al repositorio público
frontend/cuentas.txt

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- IDE / SO ----------
.vscode/
.idea/
*.iml
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- Tests ----------
test-results/
playwright-report/
blob-report/
.playwright/

# ---------- Varios ----------
*.local
